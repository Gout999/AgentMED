# eval-harness 配置（环境变量；复制为 .env 并按需修改。密钥永不入库）
# 复制用法：cp .env.example .env

# ---- demo-app Quality API（live 集成目标）----
# 默认指向本地 compose 起的 demo-app
CASELOOP_QUALITY_API_BASE_URL=http://127.0.0.1:8080
# 读面令牌（demo-app 默认 conformance 占位值；真实部署由 Higress 托管注入）
CASELOOP_READ_TOKEN=conformance-read-token
# 写面令牌（仅 Release Controller 持有；eval-harness 扮演注入/复位角色用）

# ---- StepFun（运动员模型 / 裁判模型）----
# 未设置时 live 测试 skip 并标注（验收环境有 key，会真跑）
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-3.7-flash
# 裁判模型（必须 ≠ 运动员模型，T6 硬校验）。缺省不设 → 裁判轨 live 标 UNAVAILABLE。
# 示例：裁判用 step-2-16k（若账号存在）；或用其他厂商/型号
JUDGE_MODEL=
# 裁判独立 provider（可选）：JUDGE_API_KEY + JUDGE_BASE_URL 同时设置才生效，
# 裁判走第二个 OpenAI 兼容 endpoint（如 glm-5.2 走独立 gateway），与运动员链路完全隔离；
# 只设其一或都不设 → 沿用上方 StepFun 配置（旧行为不变）。
JUDGE_API_KEY=
JUDGE_BASE_URL=
# 裁判 provider 标签：进入裁判 model_digest 的 {"provider": ...} 字段，供审计比对。
# 用独立 gateway 时改成对应提供方标签（如 openagents）；缺省 stepfun（沿用运动员链路时的旧口径）。
JUDGE_PROVIDER=stepfun

# ---- 集中限速（D-001：默认 8 RPM 上限，留 2 给 AgentTeams worker）----
LLM_RPM_LIMIT=8

# ---- 实验协议（D-001 裁决值）----
# 每 cell 每探针重复次数 n=5；B1 集成测试按 fixtures/b1 冻结值 repetitions=3
EXPERIMENT_REPETITIONS=5
# 最小有实际意义效应量 δ_min
EXPERIMENT_DELTA_MIN=0.2
# INCONCLUSIVE 补实验上限（超限升级人工）
EXPERIMENT_MAX_SUPPLEMENTS=2
# 置信水平（固定 0.95）
EXPERIMENT_CONFIDENCE=0.95

# ---- 门禁 ----
# 裁判轨 pass 阈值
GATE_JUDGE_PASS_THRESHOLD=0.8
