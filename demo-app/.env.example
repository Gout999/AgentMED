# demo-app「小智客服」环境变量模板 —— 复制为 .env 并填真实值（.env 已被 gitignore，不入库）
# StepFun LLM（真实调用，禁止 mock；key 只存仓库外）
STEPFUN_API_KEY=sk-xxx
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-3.7-flash

# 数据库（compose 内用 postgres 主机名；本机直跑用 127.0.0.1）
DATABASE_URL=postgresql+psycopg://caseloop:caseloop@postgres:5432/demo_app

# Quality API 演示令牌（conformance 缺省值；真实部署由 Higress 凭证托管注入）
# 写面令牌按契约仅 Release Controller 持有
CASELOOP_READ_TOKEN=
CASELOOP_WRITE_TOKEN=
RELEASE_CONTROLLER_CLIENT_SECRET=
QUALITY_READER_CLIENT_SECRET=

# 集中限速器（RPM 上限，D-001：8 RPM 留 2 余量给 AgentTeams worker）
LLM_RPM_LIMIT=8
LLM_RETRY_MAX_ATTEMPTS=5
LLM_RETRY_BACKOFF_BASE_SECONDS=1.0
LLM_RETRY_BACKOFF_MAX_SECONDS=30.0

# 异步 operation TTL（Q1 裁决：24h）
OPERATION_TTL_HOURS=24

# OTel（无 collector 时留空 → 自动降级 no-op）
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=demo-app-xiaozhi
OTEL_TRACES_EXPORTER=otlp

# 服务监听
HOST=0.0.0.0
PORT=8080
