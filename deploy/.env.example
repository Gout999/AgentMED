# AgentMED local Compose environment. Copy to deploy/.env and replace every
# blank required secret before running `docker compose up`.
# Generate independent local secrets with, for example: openssl rand -hex 32

# Network exposure. Keep loopback unless you intentionally add an authenticated
# ingress or firewall policy in front of the stack.
AGENTMED_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
DEMO_APP_HOST_PORT=8080
CONTROL_PLANE_HOST_PORT=18090
CONSOLE_HOST_PORT=8087

# PostgreSQL. Use a URL-safe random password because Compose injects this value
# into the local SQLAlchemy connection URLs. POSTGRES_PASSWORD initializes a
# new volume; it does not rotate credentials in an existing agentmed_pgdata
# volume. Existing installations must rotate that database role explicitly.
POSTGRES_USER=agentmed
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Demo Quality API bearer and OAuth credentials. All four values must be
# non-empty; read/write values and reader/release client secrets must be distinct.
AGENTMED_READ_TOKEN=
AGENTMED_WRITE_TOKEN=
RELEASE_CONTROLLER_CLIENT_SECRET=
QUALITY_READER_CLIENT_SECRET=

# Deterministic control-plane authorities. Every token, including every value
# in CONTROL_PLANE_ROLE_TOKENS_JSON, must be unique.
CONTROL_PLANE_TOKEN=
APPROVAL_AUTHORITY_TOKEN=
GATE_AUTHORITY_TOKEN=
# Required JSON object with quality-officer, collector, case-officer,
# attributionist, repairer and gatekeeper keys.
CONTROL_PLANE_ROLE_TOKENS_JSON=

# Public V4/V5 authority namespace. These must be distinct from each other and
# from all internal authority/role tokens above.
PUBLIC_CREDENTIAL_HASH_PEPPER=
PUBLIC_CURSOR_SIGNING_KEY=
PUBLIC_AUTH_ISSUER=https://auth.agentmed.dev

# Optional provider/runtime configuration. Disabled remains fail closed.
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
OTEL_EXPORTER_OTLP_ENDPOINT=
ALLOW_DEMO_FAULT_INJECTION=false
NOTIFICATION_ADAPTER=disabled
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
