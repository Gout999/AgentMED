{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseloop.dev/schemas/v5/dependency-edges.get.schema.json",
  "title": "dependency-edges.get",
  "description": "R2 activated V5 dependency edge read. Mirrors control-plane/app/public_api/v5_models.py DependencyEdgeGetResponse; edge carries the full DependencyEdgeRecord (records.schema.json#/$defs/dependencyEdgeRecord).",
  "$defs": {
    "request": {
      "description": "dependency-edges.get is a GET with no request body.",
      "type": "null"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_id", "audit_ref", "edge"],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion2" },
        "workspace_id": { "$ref": "common.schema.json#/$defs/idWorkspaceId" },
        "request_id": { "$ref": "common.schema.json#/$defs/idRequestId" },
        "audit_ref": { "$ref": "common.schema.json#/$defs/auditRef" },
        "edge": { "$ref": "records.schema.json#/$defs/dependencyEdgeRecord" }
      }
    },
    "error": { "$ref": "common.schema.json#/$defs/errorEnvelope" }
  }
}
