{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseloop.dev/schemas/v5/applications.get.schema.json",
  "title": "applications.get",
  "description": "R2 activated V5 application fetch by id. Mirrors control-plane/app/public_api/v5_models.py ApplicationGetResponse; application is the full ApplicationRecord from records.schema.json (revision-1 REGISTERED or revision >= 2 ACTIVE/ARCHIVED union shape).",
  "$defs": {
    "request": {
      "description": "applications.get is a GET with no request body.",
      "type": "null"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_id", "audit_ref", "application"],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion2" },
        "workspace_id": { "$ref": "common.schema.json#/$defs/idWorkspaceId" },
        "request_id": { "$ref": "common.schema.json#/$defs/idRequestId" },
        "audit_ref": { "$ref": "common.schema.json#/$defs/auditRef" },
        "application": { "$ref": "records.schema.json#/$defs/applicationRecord" }
      }
    },
    "error": { "$ref": "common.schema.json#/$defs/errorEnvelope" }
  }
}
