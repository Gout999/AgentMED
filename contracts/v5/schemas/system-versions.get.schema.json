{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseloop.dev/schemas/v5/system-versions.get.schema.json",
  "title": "system-versions.get",
  "description": "D2 frozen read of one SystemVersionSet. Re-authorizes every call and recursively verifies record/envelope/digest/event/outbox/audit/AuthorityReceipt before returning. Contract-only: NOT activated.",
  "$defs": {
    "request": {
      "description": "GET with no request body; system_version_set_id is a path parameter.",
      "type": "null"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workspace_id",
        "request_id",
        "audit_ref",
        "system_version_set"
      ],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schemaVersion2"
        },
        "workspace_id": {
          "$ref": "common.schema.json#/$defs/idWorkspaceId"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/idRequestId"
        },
        "audit_ref": {
          "$ref": "common.schema.json#/$defs/auditRef"
        },
        "system_version_set": {
          "$ref": "#/$defs/recordedSystemVersionSet"
        }
      }
    },
    "recordedSystemVersionSet": {
      "$ref": "system-versions.record.schema.json#/$defs/recordedSystemVersionSet"
    },
    "exactComponentRevisionBinding": {
      "$ref": "system-versions.record.schema.json#/$defs/exactComponentRevisionBinding"
    },
    "exactTopologyRevisionBinding": {
      "$ref": "system-versions.record.schema.json#/$defs/exactTopologyRevisionBinding"
    },
    "identityAssuranceSummary": {
      "$ref": "system-versions.record.schema.json#/$defs/identityAssuranceSummary"
    },
    "identityAssuranceEntry": {
      "$ref": "system-versions.record.schema.json#/$defs/identityAssuranceEntry"
    },
    "error": {
      "$ref": "common.schema.json#/$defs/errorEnvelope"
    }
  }
}
