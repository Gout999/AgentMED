{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseloop.dev/schemas/v5/system-components.get.schema.json",
  "title": "system-components.get",
  "description": "R2 activated V5 system component fetch by id. Mirrors control-plane/app/public_api/v5_models.py ComponentGetResponse; component is the full SystemComponentRecord from records.schema.json.",
  "$defs": {
    "request": {
      "description": "system-components.get is a GET with no request body.",
      "type": "null"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_id", "audit_ref", "component"],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion2" },
        "workspace_id": { "$ref": "common.schema.json#/$defs/idWorkspaceId" },
        "request_id": { "$ref": "common.schema.json#/$defs/idRequestId" },
        "audit_ref": { "$ref": "common.schema.json#/$defs/auditRef" },
        "component": { "$ref": "records.schema.json#/$defs/componentRecord" }
      }
    },
    "error": { "$ref": "common.schema.json#/$defs/errorEnvelope" }
  }
}
