{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseloop.dev/schemas/v5/environments.get.schema.json",
  "title": "environments.get",
  "description": "R2 activated V5 environment fetch by id. Mirrors control-plane/app/public_api/v5_models.py EnvironmentGetResponse; environment is the full EnvironmentRecord from records.schema.json.",
  "$defs": {
    "request": {
      "description": "environments.get is a GET with no request body.",
      "type": "null"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_id", "audit_ref", "environment"],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion2" },
        "workspace_id": { "$ref": "common.schema.json#/$defs/idWorkspaceId" },
        "request_id": { "$ref": "common.schema.json#/$defs/idRequestId" },
        "audit_ref": { "$ref": "common.schema.json#/$defs/auditRef" },
        "environment": { "$ref": "records.schema.json#/$defs/environmentRecord" }
      }
    },
    "error": { "$ref": "common.schema.json#/$defs/errorEnvelope" }
  }
}
