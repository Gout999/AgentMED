{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseloop.dev/contracts/v4/schemas/mcp-manifest.schema.json",
  "title": "CaseLoop governed MCPManifest",
  "type": "object",
  "required": [
    "schema_version",
    "mcp_manifest_id",
    "revision",
    "state",
    "immutable",
    "server_name",
    "version",
    "source",
    "package",
    "transport",
    "tools",
    "tool_catalog_digest",
    "requested_permissions",
    "remote_schema_pinning_required",
    "registered_by_principal",
    "registered_at",
    "manifest_digest",
    "workspace_id",
    "previous_snapshot",
    "authority_receipt_id",
    "hash_rule"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/schema_version"
    },
    "mcp_manifest_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/mcp_manifest_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "const": "FROZEN"
    },
    "immutable": {
      "const": true
    },
    "server_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "type": "object",
      "required": [
        "repository_uri",
        "commit",
        "license_spdx",
        "content_digest"
      ],
      "properties": {
        "repository_uri": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "license_spdx": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-.+() ]{2,128}$"
        },
        "content_digest": {
          "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "package": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/artifact_ref"
    },
    "transport": {
      "type": "object",
      "required": [
        "kind",
        "command_digest",
        "endpoint_origin"
      ],
      "properties": {
        "kind": {
          "enum": [
            "STDIO",
            "STREAMABLE_HTTP",
            "SSE"
          ]
        },
        "command_digest": {
          "oneOf": [
            {
              "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoint_origin": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "input_schema_digest",
          "output_schema_digest",
          "declared_effect_class",
          "idempotent",
          "permission_requirement_digest",
          "annotations_authoritative"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
          },
          "input_schema_digest": {
            "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
          },
          "output_schema_digest": {
            "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
          },
          "declared_effect_class": {
            "enum": [
              "READ_ONLY",
              "IDEMPOTENT",
              "REVERSIBLE",
              "COMPENSATABLE",
              "IRREVERSIBLE"
            ]
          },
          "idempotent": {
            "type": "boolean"
          },
          "permission_requirement_digest": {
            "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
          },
          "annotations_authoritative": {
            "const": false
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tool_catalog_digest": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "requested_permissions": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/permission_surface"
    },
    "remote_schema_pinning_required": {
      "const": true
    },
    "registered_by_principal": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/principal_id"
    },
    "registered_at": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"
    },
    "manifest_digest": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "workspace_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/workspace_id"
    },
    "previous_snapshot": {
      "oneOf": [
        {
          "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_receipt_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/authority_receipt_id"
    },
    "hash_rule": {
      "const": "jcs-rfc8785-v1+sha256(excluding:/manifest_digest)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "properties": {
              "kind": {
                "const": "STDIO"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "transport"
        ]
      },
      "then": {
        "properties": {
          "transport": {
            "properties": {
              "command_digest": {
                "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
              },
              "endpoint_origin": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "properties": {
              "kind": {
                "enum": [
                  "STREAMABLE_HTTP",
                  "SSE"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "transport"
        ]
      },
      "then": {
        "properties": {
          "transport": {
            "properties": {
              "command_digest": {
                "type": "null"
              },
              "endpoint_origin": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "previous_snapshot": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_snapshot": {
            "type": "object"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
