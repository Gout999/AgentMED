{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseloop.dev/contracts/v4/schemas/idempotency-receipt.schema.json",
  "title": "CaseLoop public command idempotency receipt",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_id",
    "principal_id",
    "intent",
    "idempotency_key",
    "request_fingerprint",
    "resource",
    "operation_id",
    "request_id",
    "audit_ref",
    "status",
    "response_digest",
    "created_at",
    "idempotency_receipt_id",
    "immutable",
    "hash_rule",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/schema_version"
    },
    "workspace_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/workspace_id"
    },
    "principal_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/principal_id"
    },
    "intent": {
      "enum": [
        "signals.submit",
        "sources.doctor",
        "investigations.start",
        "work.stop-request",
        "approvals.decide",
        "releases.rollback-request"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "request_fingerprint": {
      "description": "Digest of canonical request content, not the receipt self-hash.",
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "resource": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "signal",
            "source_sync_run",
            "automation_request",
            "approval_grant",
            "external_operation"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[0-9A-Za-z]{8,64}$"
        }
      },
      "additionalProperties": false
    },
    "operation_id": {
      "oneOf": [
        {
          "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/operation_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/request_id"
    },
    "audit_ref": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/audit_ref"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "COMPLETED"
      ]
    },
    "response_digest": {
      "description": "Digest of the durable command result payload excluding this delivery receipt, so the response and receipt never form a cyclic hash.",
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "created_at": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"
    },
    "idempotency_receipt_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/idempotency_receipt_id"
    },
    "immutable": {
      "const": true
    },
    "hash_rule": {
      "const": "jcs-rfc8785-v1+sha256(excluding:/receipt_digest)"
    },
    "receipt_digest": {
      "description": "Whole immutable wire-response self-hash excluding only this field. Every replay returns the original receipt byte-for-byte with the same receipt id and self-hash; per-delivery replay metadata is outside this record. This is not the authoritative PostgreSQL idempotency record.",
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"intent": {"const": "signals.submit"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "kind": {"const": "signal"},
              "id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/signal_id"}
            }
          },
          "operation_id": {"type": "null"},
          "status": {"const": "COMPLETED"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "sources.doctor"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "kind": {"const": "source_sync_run"},
              "id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/source_sync_run_id"}
            }
          },
          "operation_id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/operation_id"},
          "status": {"const": "ACCEPTED"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {"enum": ["investigations.start", "work.stop-request"]}
        },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "kind": {"const": "automation_request"},
              "id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/automation_request_id"}
            }
          },
          "operation_id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/operation_id"},
          "status": {"const": "ACCEPTED"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "approvals.decide"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "kind": {"const": "approval_grant"},
              "id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/approval_id"}
            }
          },
          "operation_id": {"type": "null"},
          "status": {"const": "COMPLETED"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "releases.rollback-request"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "kind": {"const": "external_operation"},
              "id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/external_operation_id"}
            }
          },
          "operation_id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/operation_id"},
          "status": {"const": "ACCEPTED"}
        }
      }
    }
  ],
  "additionalProperties": false
}
