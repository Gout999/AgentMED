{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmed.dev/contracts/v4/schemas/trace-evidence-receipt.schema.json",
  "title": "AgentMED TraceEvidenceReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "workspace_id",
    "source_id",
    "signal_id",
    "signal_digest",
    "collection_mode",
    "agent_run_ref_id",
    "agent_run_ref_digest",
    "query",
    "requested_fields",
    "field_results",
    "completeness",
    "artifact_ref",
    "source_payload_digest",
    "collected_at",
    "retention_expires_at",
    "deep_link",
    "failure",
    "authority_receipt_id",
    "immutable",
    "hash_rule",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/schema_version"
    },
    "receipt_id": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/trace_evidence_receipt_id"
    },
    "workspace_id": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/workspace_id"
    },
    "source_id": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/source_id"
    },
    "signal_id": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/signal_id"
    },
    "signal_digest": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "collection_mode": {
      "enum": ["SOURCE_QUERY", "NO_LOCATOR"]
    },
    "agent_run_ref_id": {
      "oneOf": [
        {
          "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/agent_run_ref_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_run_ref_digest": {
      "oneOf": [
        {
          "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
        },
        {"type": "null"}
      ]
    },
    "query": {
      "oneOf": [
        {
          "type": "object",
          "required": ["adapter_kind", "endpoint_origin", "source_version", "requested_at", "window_start", "window_end", "filters_digest"],
          "properties": {
            "adapter_kind": {"enum": ["langfuse", "otel", "phoenix", "custom"]},
            "endpoint_origin": {"type": "string", "format": "uri"},
            "source_version": {"type": "string", "minLength": 1, "maxLength": 128},
            "requested_at": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"},
            "window_start": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"},
            "window_end": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"},
            "filters_digest": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "requested_fields": {
      "type": "array",
      "items": {"enum": ["trace.input", "trace.output", "observations.model", "observations.tools"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "field_results": {
      "type": "array",
      "x-agentmed-unique-by": "name",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "enum": ["trace.input", "trace.output", "observations.model", "observations.tools"]
          },
          "status": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "MISSING"
            ]
          },
          "reason_digest": {
            "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "MISSING"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "reason_digest"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "reason_digest"
                ]
              }
            }
          }
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "completeness": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/completeness"
    },
    "artifact_ref": {
      "oneOf": [
        {
          "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/artifact_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_payload_digest": {
      "description": "Digest of the separately referenced provider response payload, not the receipt self-hash.",
      "oneOf": [
        {
          "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "collected_at": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"
    },
    "retention_expires_at": {
      "oneOf": [
        {
          "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"
        },
        {
          "type": "null"
        }
      ]
    },
    "deep_link": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "failure": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "code",
            "retryable",
            "message_digest"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            "retryable": {
              "type": "boolean"
            },
            "message_digest": {
              "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_receipt_id": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/authority_receipt_id"
    },
    "immutable": {
      "const": true
    },
    "hash_rule": {
      "const": "jcs-rfc8785-v1+sha256(excluding:/receipt_digest)"
    },
    "receipt_digest": {
      "description": "Whole TraceEvidenceReceipt self-hash excluding only this top-level field.",
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "collection_mode": {"const": "NO_LOCATOR"}
        },
        "required": ["collection_mode"]
      },
      "then": {
        "properties": {
          "query": {"type": "null"},
          "agent_run_ref_id": {"type": "null"},
          "agent_run_ref_digest": {"type": "null"},
          "completeness": {"const": "UNKNOWN"},
          "artifact_ref": {"type": "null"},
          "source_payload_digest": {"type": "null"},
          "deep_link": {"type": "null"},
          "requested_fields": {
            "minItems": 4,
            "maxItems": 4,
            "allOf": [
              {"contains": {"const": "trace.input"}, "minContains": 1, "maxContains": 1},
              {"contains": {"const": "trace.output"}, "minContains": 1, "maxContains": 1},
              {"contains": {"const": "observations.model"}, "minContains": 1, "maxContains": 1},
              {"contains": {"const": "observations.tools"}, "minContains": 1, "maxContains": 1}
            ]
          },
          "field_results": {
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "properties": {"status": {"const": "MISSING"}}
            },
            "allOf": [
              {
                "contains": {
                  "properties": {"name": {"const": "trace.input"}},
                  "required": ["name"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {"name": {"const": "trace.output"}},
                  "required": ["name"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {"name": {"const": "observations.model"}},
                  "required": ["name"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {"name": {"const": "observations.tools"}},
                  "required": ["name"]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          },
          "failure": {
            "type": "object",
            "properties": {
              "code": {"const": "NO_TRACE_LOCATOR"},
              "retryable": {"const": false}
            }
          }
        }
      },
      "else": {
        "properties": {"query": {"type": "object"}}
      }
    },
    {
      "if": {
        "properties": {"agent_run_ref_id": {"type": "null"}},
        "required": ["agent_run_ref_id"]
      },
      "then": {"properties": {"agent_run_ref_digest": {"type": "null"}}},
      "else": {
        "properties": {
          "agent_run_ref_digest": {
            "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completeness": {
            "const": "COMPLETE"
          }
        },
        "required": [
          "completeness"
        ]
      },
      "then": {
        "properties": {
          "field_results": {
            "items": {
              "properties": {
                "status": {
                  "const": "OBSERVED"
                }
              }
            }
          },
          "artifact_ref": {
            "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/artifact_ref"
          },
          "failure": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completeness": {
            "const": "PARTIAL"
          }
        },
        "required": [
          "completeness"
        ]
      },
      "then": {
        "properties": {
          "field_results": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "OBSERVED"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "MISSING"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "minContains": 1
              }
            ]
          },
          "artifact_ref": {
            "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/artifact_ref"
          },
          "failure": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completeness": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "completeness"
        ]
      },
      "then": {
        "properties": {
          "field_results": {
            "contains": {
              "properties": {
                "status": {
                  "const": "MISSING"
                }
              },
              "required": [
                "status"
              ]
            },
            "minContains": 1
          },
          "failure": {
            "type": "object"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
