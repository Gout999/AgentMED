{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmed.dev/contracts/v4/schemas/candidate-revision.schema.json",
  "title": "AgentMED post-build CandidateRevision",
  "description": "Immutable result of one producer Attempt under an exact frozen CandidateContract.",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_revision_id",
    "candidate_id",
    "revision",
    "workspace_id",
    "case_id",
    "resolution_contract",
    "candidate_contract",
    "accepted_proposal",
    "candidate_kind",
    "input_snapshot_digest",
    "base",
    "target",
    "candidate_artifact",
    "diff_artifact",
    "receipt_set_digest",
    "state",
    "recorded_by_principal",
    "recorded_at",
    "immutable",
    "hash_rule",
    "revision_digest",
    "authority_receipt_id",
    "producer_attempt"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/schema_version"
    },
    "candidate_revision_id": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/candidate_revision_id"
    },
    "candidate_id": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/candidate_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "workspace_id": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/workspace_id"
    },
    "case_id": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/case_id"
    },
    "resolution_contract": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/resource_binding"
    },
    "candidate_contract": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/resource_binding"
    },
    "accepted_proposal": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"
    },
    "candidate_kind": {
      "enum": [
        "PROMPT",
        "KNOWLEDGE",
        "MODEL_CONFIG",
        "SKILL",
        "MCP",
        "CODE_PATCH",
        "HARNESS",
        "POLICY",
        "EVALUATOR_ASSET"
      ]
    },
    "input_snapshot_digest": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "base": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/target_revision"
    },
    "target": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/target_revision"
    },
    "candidate_artifact": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/artifact_ref"
    },
    "diff_artifact": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/artifact_ref"
    },
    "receipt_set_digest": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "state": {
      "const": "RECORDED"
    },
    "recorded_by_principal": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/principal_id"
    },
    "recorded_at": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"
    },
    "immutable": {
      "const": true
    },
    "hash_rule": {
      "const": "jcs-rfc8785-v1+sha256(excluding:/revision_digest)"
    },
    "revision_digest": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "authority_receipt_id": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/authority_receipt_id"
    },
    "producer_attempt": {
      "$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"
    }
  },
  "additionalProperties": false
}
