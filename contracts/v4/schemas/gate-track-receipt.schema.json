{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmed.dev/contracts/v4/schemas/gate-track-receipt.schema.json",
  "title": "AgentMED GateTrackReceipt",
  "description": "Immutable terminal result for one exact Gate track. GateReport references this record by exact id/revision/digest; this record never references a future GateReport.",
  "type": "object",
  "required": [
    "schema_version",
    "gate_track_receipt_id",
    "workspace_id",
    "case_id",
    "gate_execution_id",
    "resolution_contract",
    "candidate_contract",
    "candidate_revision",
    "evaluation_plan",
    "track",
    "status",
    "completeness",
    "executor",
    "evidence_receipts",
    "evidence_facets",
    "terminal_reason_digest",
    "started_at",
    "completed_at",
    "authority_receipt_id",
    "immutable",
    "hash_rule",
    "gate_track_receipt_digest"
  ],
  "$defs": {
    "track": {"enum": ["RULE", "DETERMINISTIC_TEST", "INDEPENDENT_JUDGE", "SANDBOX_SIDE_EFFECT"]},
    "status": {"enum": ["PASS", "FAILED", "INCONCLUSIVE", "ERROR", "UNKNOWN"]},
    "agent_judge": {
      "type": "object",
      "required": ["kind", "execution", "evaluator_version_digest"],
      "properties": {
        "kind": {"const": "AGENT_JUDGE"},
        "execution": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/agent_execution_identity"},
        "evaluator_version_digest": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "required": ["kind", "principal_id", "runner_digest", "run_receipt"],
      "properties": {
        "kind": {"enum": ["RULE_ENGINE", "DETERMINISTIC_RUNNER", "SANDBOX_RUNNER"]},
        "principal_id": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/principal_id"},
        "runner_digest": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"},
        "run_receipt": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/resource_binding"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/schema_version"},
    "gate_track_receipt_id": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/gate_track_receipt_id"},
    "workspace_id": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/workspace_id"},
    "case_id": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/case_id"},
    "gate_execution_id": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/gate_execution_id"},
    "resolution_contract": {
      "allOf": [
        {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"},
        {"properties": {"kind": {"const": "RESOLUTION_CONTRACT"}}}
      ]
    },
    "candidate_contract": {
      "allOf": [
        {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"},
        {"properties": {"kind": {"const": "CANDIDATE_CONTRACT"}}}
      ]
    },
    "candidate_revision": {
      "allOf": [
        {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"},
        {"properties": {"kind": {"const": "CANDIDATE_REVISION"}}}
      ]
    },
    "evaluation_plan": {
      "allOf": [
        {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"},
        {"properties": {"kind": {"const": "EVALUATION_PLAN"}}}
      ]
    },
    "track": {"$ref": "#/$defs/track"},
    "status": {"$ref": "#/$defs/status"},
    "completeness": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/completeness"},
    "executor": {"oneOf": [{"$ref": "#/$defs/agent_judge"}, {"$ref": "#/$defs/runner"}]},
    "evidence_receipts": {
      "type": "array",
      "items": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/resource_binding"},
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_facets": {
      "type": "array",
      "items": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/evidence_facet"},
      "minItems": 1,
      "uniqueItems": true
    },
    "terminal_reason_digest": {
      "oneOf": [
        {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "started_at": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"},
    "completed_at": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"},
    "authority_receipt_id": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/authority_receipt_id"},
    "immutable": {"const": true},
    "hash_rule": {"const": "jcs-rfc8785-v1+sha256(excluding:/gate_track_receipt_digest)"},
    "gate_track_receipt_digest": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"track": {"const": "INDEPENDENT_JUDGE"}}, "required": ["track"]},
      "then": {"properties": {"executor": {"$ref": "#/$defs/agent_judge"}}},
      "else": {"properties": {"executor": {"$ref": "#/$defs/runner"}}}
    },
    {
      "if": {"properties": {"track": {"const": "DETERMINISTIC_TEST"}}, "required": ["track"]},
      "then": {"properties": {"executor": {"properties": {"kind": {"const": "DETERMINISTIC_RUNNER"}}}}}
    },
    {
      "if": {"properties": {"track": {"const": "RULE"}}, "required": ["track"]},
      "then": {"properties": {"executor": {"properties": {"kind": {"const": "RULE_ENGINE"}}}}}
    },
    {
      "if": {"properties": {"track": {"const": "SANDBOX_SIDE_EFFECT"}}, "required": ["track"]},
      "then": {"properties": {"executor": {"properties": {"kind": {"const": "SANDBOX_RUNNER"}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "completeness": {"const": "COMPLETE"},
          "terminal_reason_digest": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "terminal_reason_digest": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"}
        }
      }
    }
  ],
  "additionalProperties": false
}
