{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseloop.dev/contracts/v4/schemas/proposal.schema.json",
  "title": "CaseLoop typed Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "workspace_id",
    "case_id",
    "worker_task_id",
    "authored_by_attempt_id",
    "authored_by_attempt",
    "authored_by_principal",
    "submitted_by_principal",
    "proposal_type",
    "agent_manifest",
    "input_snapshot_digest",
    "content_ref",
    "receipt_set_digest",
    "candidate_contract",
    "delegation",
    "submitted_at",
    "controlled_action_not_started",
    "immutable",
    "hash_rule",
    "proposal_digest",
    "authority_receipt_id"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/schema_version"
    },
    "proposal_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/proposal_id"
    },
    "workspace_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/workspace_id"
    },
    "case_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/case_id"
    },
    "worker_task_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/worker_task_id"
    },
    "authored_by_attempt_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/attempt_id"
    },
    "authored_by_attempt": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"
    },
    "authored_by_principal": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/principal_id"
    },
    "submitted_by_principal": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/principal_id"
    },
    "proposal_type": {
      "enum": [
        "CASE_BRIEF",
        "ATTRIBUTION_HYPOTHESIS",
        "RESOLUTION_CONTRACT",
        "DELEGATION",
        "CHANGE",
        "REGRESSION",
        "FINDING",
        "CAPABILITY_GAP"
      ]
    },
    "agent_manifest": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"
    },
    "input_snapshot_digest": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "content_ref": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/artifact_ref"
    },
    "receipt_set_digest": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "candidate_contract": {
      "oneOf": [
        {
          "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "delegation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "requested_runtime_kind",
            "requested_role",
            "requested_model",
            "capability_requirements_digest",
            "child_input_digest"
          ],
          "properties": {
            "requested_runtime_kind": {
              "enum": [
                "CLAUDE_CODE",
                "CODEX",
                "QWEN_CODE",
                "CUSTOM"
              ]
            },
            "requested_role": {
              "type": "string",
              "minLength": 1
            },
            "requested_model": {
              "type": "string",
              "minLength": 1
            },
            "capability_requirements_digest": {
              "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
            },
            "child_input_digest": {
              "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "submitted_at": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"
    },
    "controlled_action_not_started": {
      "const": true
    },
    "immutable": {
      "const": true
    },
    "hash_rule": {
      "const": "jcs-rfc8785-v1+sha256(excluding:/proposal_digest)"
    },
    "proposal_digest": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"
    },
    "authority_receipt_id": {
      "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/authority_receipt_id"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proposal_type": {
            "const": "DELEGATION"
          }
        },
        "required": [
          "proposal_type"
        ]
      },
      "then": {
        "properties": {
          "delegation": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposal_type": {
            "const": "CHANGE"
          }
        },
        "required": [
          "proposal_type"
        ]
      },
      "then": {
        "properties": {
          "candidate_contract": {
            "$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
