    "source_sync_run_response": {
      "type": "object",
      "required": ["schema_version", "workspace_id", "request_id", "audit_ref", "data"],
      "properties": {
        "schema_version": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/schema_version"},
        "workspace_id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/workspace_id"},
        "request_id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/request_id"},
        "audit_ref": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/audit_ref"},
        "data": {
          "type": "object",
          "required": [
            "source_sync_run_id", "operation_id", "source_id", "run_kind", "status", "requested_checks", "capability_digest",
            "evidence_receipt_ids", "terminal_error", "reconcile_required", "requested_at", "started_at", "completed_at", "updated_at"
          ],
          "properties": {
            "source_sync_run_id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/source_sync_run_id"},
            "operation_id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/operation_id"},
            "source_id": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/source_id"},
            "run_kind": {"enum": ["DOCTOR", "POLL", "REPLAY"]},
            "status": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "UNKNOWN"]},
            "requested_checks": {"type": "array", "items": {"enum": ["AUTHENTICATION", "AUTHORIZATION", "CONNECTIVITY", "CAPABILITIES", "RETENTION", "MASKING"]}, "minItems": 1, "uniqueItems": true},
            "capability_digest": {"$ref": "#/$defs/nullable_digest"},
            "evidence_receipt_ids": {"type": "array", "items": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/trace_evidence_receipt_id"}, "uniqueItems": true},
            "terminal_error": {"$ref": "#/$defs/terminal_error"},
            "reconcile_required": {"type": "boolean"},
            "requested_at": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"},
            "started_at": {"$ref": "#/$defs/nullable_date_time"},
            "completed_at": {"$ref": "#/$defs/nullable_date_time"},
            "updated_at": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "UNKNOWN"}}, "required": ["status"]},
              "then": {"properties": {"reconcile_required": {"const": true}, "terminal_error": {"type": "object"}}}
            },
            {
              "if": {"properties": {"status": {"const": "SUCCEEDED"}}, "required": ["status"]},
              "then": {"properties": {"terminal_error": {"type": "null"}, "reconcile_required": {"const": false}, "capability_digest": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"}, "completed_at": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"}}}
            },
            {
              "if": {"properties": {"status": {"const": "FAILED"}}, "required": ["status"]},
              "then": {"properties": {"terminal_error": {"type": "object"}, "reconcile_required": {"const": false}, "completed_at": {"$ref": "https://caseloop.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"}}}
            },
            {
              "if": {"properties": {"status": {"enum": ["QUEUED", "RUNNING"]}}, "required": ["status"]},
              "then": {"properties": {"terminal_error": {"type": "null"}, "reconcile_required": {"const": false}, "completed_at": {"type": "null"}}}
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
