{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmed.dev/contracts/v4/schemas/authority-receipt.schema.json",
  "title": "AgentMED AuthorityReceipt",
  "description": "Post-record, same-transaction proof that a registered Controller recorded an exact subject. It is not a CapabilityLease, ApprovalGrant, or execution permission, and an offline fixture proves contract shape only.",
  "type": "object",
  "required": [
    "schema_version",
    "authority_receipt_id",
    "workspace_id",
    "controller_registration",
    "subject",
    "resource",
    "owner",
    "controller_principal",
    "command",
    "event_type",
    "event_id",
    "transaction_id",
    "audit_ref",
    "recorded_at",
    "immutable",
    "hash_rule",
    "authority_receipt_digest"
  ],
  "properties": {
    "schema_version": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/schema_version"},
    "authority_receipt_id": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/authority_receipt_id"},
    "workspace_id": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/workspace_id"},
    "controller_registration": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"},
    "subject": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/exact_record_binding"},
    "resource": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "controller_principal": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/principal_id"},
    "command": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/intent_name"},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
    "event_id": {"type": "string", "pattern": "^evt_[0-9A-Za-z]{8,64}$"},
    "transaction_id": {"type": "string", "pattern": "^txn_[0-9A-Za-z]{8,64}$"},
    "audit_ref": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/audit_ref"},
    "recorded_at": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/date_time"},
    "immutable": {"const": true},
    "hash_rule": {"const": "jcs-rfc8785-v1+sha256(excluding:/authority_receipt_digest)"},
    "authority_receipt_digest": {"$ref": "https://agentmed.dev/contracts/v4/schemas/common-defs.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
