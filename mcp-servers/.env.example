# CaseLoop mcp-servers 环境变量模板
# 复制为 .env 后填写（.env 不入库）

# ---- 数据库（PG 生产 / SQLite 单测） ----
DATABASE_URL=postgresql+psycopg://caseloop:caseloop@127.0.0.1:5432/control_plane
# 案例库可单独指向 casebase 库；留空复用 DATABASE_URL
CASEBASE_DATABASE_URL=
# 通知 mock 日志可单独指向；留空复用 DATABASE_URL
NOTIFICATION_LOG_URL=

# ---- 上游依赖（case-admin / release-admin 包装的 REST 面） ----
CONTROL_PLANE_BASE_URL=http://127.0.0.1:8090
CONTROL_PLANE_TOKEN=
QUALITY_API_BASE_URL=http://127.0.0.1:8080
QUALITY_READ_TOKEN=conformance-read-token
QUALITY_WRITE_TOKEN=

# ---- 审批安全件 ----
APPROVAL_TTL_MINUTES=30

# ---- 信任账本 ----
TRUST_COOLOFF_HOURS=24
TRUST_PROMOTION_THRESHOLD=0.9

# ---- 各 server 端口（PathRewrite uvicorn :8xxx） ----
MCP_HOST=0.0.0.0
CASE_ADMIN_PORT=8001
RELEASE_ADMIN_PORT=8002
EVAL_RUNNER_PORT=8003
NOTIFICATION_PORT=8004
CASEBASE_PORT=8005

# ---- 审计 ----
AUDIT_JSONL_PATH=./var/mcp-audit.jsonl
# 仅测试：审计写失败开关
AUDIT_FORCE_FAIL=false

LOG_LEVEL=INFO
