# AgentMED control-plane 环境变量模板（复制为 .env 后填写；.env 不入库）

# 数据库（integration / 本地开发）
DATABASE_URL=postgresql+psycopg://agentmed:agentmed@127.0.0.1:5432/control_plane

# Quality API（被治理应用；Release Controller 写面唯一调用方）
QUALITY_API_BASE_URL=http://127.0.0.1:8080
QUALITY_API_TOKEN=
CONTROL_PLANE_TOKEN=
APPROVAL_AUTHORITY_TOKEN=
GATE_AUTHORITY_TOKEN=
# JSON object with distinct tokens for the six fixed MCP roles. Never reuse a
# controller, approval, or gate-authority token.
CONTROL_PLANE_ROLE_TOKENS_JSON={}
REQUIRE_MCP_ROLE_TOKENS=true
# Public V4/V5 authority namespace. Both are required for public API readiness,
# must differ from each other, and may not reuse any internal authority/role token.
PUBLIC_CREDENTIAL_HASH_PEPPER=
PUBLIC_CURSOR_SIGNING_KEY=
PUBLIC_AUTH_ISSUER=https://auth.caseloop.dev
# Deterministic attribution threshold. The control plane recomputes the
# EvidenceBundle/AttributionReport decision with this value.
ATTRIBUTION_DELTA_MIN=0.2
# live is fail-closed. isolated-replay is permitted only by the explicit B1
# replay command and never turns a skipped provider track into a live pass.
GATE_POLICY_PROFILE=live
ALLOW_ISOLATED_REPLAY_GATE=false
ALLOW_DEMO_FAULT_INJECTION=false
ALLOW_ISOLATED_REPLAY_ATTRIBUTION=false

# 租约 / 去重 / 审批 / 灰度（D-001 默认值）
LEASE_TTL_SECONDS=60
COMPLAINT_DEDUP_WINDOW_HOURS=24
APPROVAL_TTL_MINUTES=30
CANARY_STEPS=5,25,100
CANARY_OBSERVATION_SECONDS=120
OPERATION_TTL_HOURS=24
# 异步写操作轮询超时（秒；结果不可考 → UNKNOWN → reconcile）
OPERATION_POLL_TIMEOUT_SECONDS=5

# reconcile 退避（秒）
RECONCILE_BACKOFF_INITIAL_SECONDS=5
RECONCILE_BACKOFF_MAX_SECONDS=300

# Transactional outbox dispatcher (fixed one-worker Phase 1 pool)
OUTBOX_RELAY_INTERVAL_SECONDS=1
OUTBOX_CLAIM_TTL_SECONDS=30
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_INITIAL_SECONDS=2
OUTBOX_RETRY_MAX_SECONDS=300
# disabled is fail-closed. feishu-mock is contract/replay only. feishu-live
# requires the credentials below and replies to the original Feishu message_id.
NOTIFICATION_ADAPTER=disabled
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_TIMEOUT_SECONDS=10

# 服务
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=8090
LOG_LEVEL=INFO

# 审计 jsonl 导出路径（仅导出物，权威源=DB）
AUDIT_JSONL_PATH=./var/audit.jsonl
